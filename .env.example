DATABASE_URL=postgresql+psycopg://parp_user:parp_password@localhost:5432/parp_db

# Generate a long random value locally. Never commit the real value.
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_EXPIRE_MINUTES=5
ALLOWED_EMAIL_DOMAIN=meo.edu.ps

# Mailbox/SMTP credentials. Use the provider values for the mailbox that sends OTPs.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=S@mailbox
MAIL_PASSWORD=S@mailbox-password
MAIL_FROM=no-reply@meo.edu.ps
MAIL_STARTTLS=true

# Local MinIO from docker-compose.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=parp_minio
MINIO_SECRET_KEY=replace_with_a_strong_minio_secret
MINIO_BUCKET=parp-profile-images
MINIO_SECURE=false

# Create this in the OpenAI API platform. Never commit your real key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Vite dev server. Change this to your deployed frontend origin in production.
FRONTEND_ORIGIN=http://localhost:5173
